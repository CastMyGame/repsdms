{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REPS reviewed tenant manifest v2 \u2014 offline, non-executable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "targetTag",
    "keyTag",
    "inventoryDigest",
    "reviewedBy",
    "schoolIds",
    "entries",
    "components",
    "currencyActors"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reps-tenant-manifest/v2"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,120}$"
    },
    "targetTag": {
      "$ref": "#/$defs/digest"
    },
    "keyTag": {
      "$ref": "#/$defs/digest"
    },
    "inventoryDigest": {
      "$ref": "#/$defs/digest"
    },
    "reviewedBy": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,80}$"
    },
    "schoolIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordKey",
          "beforeDigest",
          "protectedDigest",
          "tenantSchoolId",
          "mode",
          "evidence"
        ],
        "properties": {
          "recordKey": {
            "$ref": "#/$defs/digest"
          },
          "beforeDigest": {
            "$ref": "#/$defs/digest"
          },
          "protectedDigest": {
            "$ref": "#/$defs/digest"
          },
          "tenantSchoolId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "mode": {
            "enum": [
              "bind-root",
              "compatibility-only"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "accountKey": {
            "$ref": "#/$defs/digest"
          },
          "profileKey": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentKey",
          "beforeDigest",
          "tenantSchoolId",
          "evidence"
        ],
        "properties": {
          "componentKey": {
            "$ref": "#/$defs/digest"
          },
          "beforeDigest": {
            "$ref": "#/$defs/digest"
          },
          "tenantSchoolId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "accountKey": {
            "$ref": "#/$defs/digest"
          },
          "profileKey": {
            "$ref": "#/$defs/digest"
          },
          "credentialVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "currencyActors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountKey",
          "profileKey",
          "tenantSchoolId",
          "namespaceKeys",
          "historyComplete",
          "evidence"
        ],
        "properties": {
          "accountKey": {
            "$ref": "#/$defs/digest"
          },
          "profileKey": {
            "$ref": "#/$defs/digest"
          },
          "tenantSchoolId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "namespaceKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/digest"
            }
          },
          "historyComplete": {
            "const": true
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "validationStatus"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reviewed-onboarding",
            "reviewed-historical-record",
            "verified-existing-id"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,120}$"
        },
        "validationStatus": {
          "const": "reviewed"
        }
      }
    }
  }
}
